# .gitignore for ShooterBackend .NET project

# Ignore build output directories
bin/
obj/

# Ignore user-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Ignore Visual Studio Code settings
.vscode/

# Ignore OS generated files
.DS_Store
Thumbs.db

# Ignore logs
*.log

# Ignore other common files
*.tmp
*.temp
~$*

# Ignore Rider IDE files
.idea/
*.sln.iml
